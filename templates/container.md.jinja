<div class="container-versions" data-page-size="3" data-load-size="5" markdown="1">

| Track | Image Tags | App Version | Published |
| --- | --- | --- | --- |
{% for release in versions.releases -%}
| {{ release.track | cell }} | {% for tag in release.tags %}<button type="button" class="container-tag" data-container-image="{{ versions.image | cell }}" data-container-tag="{{ tag | cell }}" aria-pressed="{{ 'true' if tag == default_tag else 'false' }}"><code>{{ tag | cell }}</code></button>{% if not loop.last %} {% endif %}{% endfor %} | <code>{{ release.version | cell }}</code> | [{{ release.publishedAt[:16] | replace('T', ' ') | cell }}]({{ releases_url }}/tag/{{ release.releaseTag | urlencode }}) |
{% endfor %}

{% if versions.releases | length > 3 %}
<button type="button" class="md-button container-versions-more" hidden>List more</button>
{% endif %}

</div>
